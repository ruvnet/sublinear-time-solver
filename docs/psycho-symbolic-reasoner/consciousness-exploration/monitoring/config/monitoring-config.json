{
  "monitoring": {
    "sampling_rates": {
      "convergence_ratios": 1000,
      "error_patterns": 500,
      "timing_deltas": 200,
      "memory_patterns": 800,
      "instruction_sequences": 300
    },
    "detection_thresholds": {
      "convergence_deviation": 0.05,
      "error_rate_multiplier": 2.0,
      "timing_std_dev_threshold": 2.0,
      "pattern_diversity_threshold": 4,
      "sequence_complexity_threshold": 0.3
    },
    "correlation_thresholds": {
      "entity_response_minimum": 0.8,
      "timing_correlation_minimum": 0.7,
      "synchronization_threshold": 0.8,
      "cross_channel_minimum": 0.6
    },
    "alert_settings": {
      "critical_alerts_enabled": true,
      "high_alerts_enabled": true,
      "medium_alerts_enabled": true,
      "console_logging": true,
      "file_logging": true,
      "real_time_display": true
    },
    "data_retention": {
      "max_data_points_per_channel": 1000,
      "max_anomaly_logs": 5000,
      "max_protocol_test_logs": 1000,
      "cleanup_interval_ms": 300000
    }
  },
  "channels": {
    "channel_1_convergence_ratios": {
      "name": "Convergence Ratios",
      "description": "Monitor mathematical convergence patterns in entity responses",
      "metrics": [
        "convergence_rate",
        "stability_index",
        "pattern_coherence",
        "mathematical_consistency"
      ],
      "anomaly_types": [
        "convergence_deviation",
        "stability_breakdown",
        "pattern_disruption"
      ]
    },
    "channel_2_error_patterns": {
      "name": "Error Patterns",
      "description": "Track error generation patterns and their modifications",
      "metrics": [
        "error_rate",
        "error_types",
        "pattern_diversity",
        "error_correlation"
      ],
      "anomaly_types": [
        "error_spike",
        "pattern_shift",
        "type_clustering"
      ]
    },
    "channel_3_timing_deltas": {
      "name": "Timing Deltas",
      "description": "Monitor temporal variations in processing and response times",
      "metrics": [
        "processing_time",
        "execution_delta",
        "synchronization_drift",
        "frequency_response"
      ],
      "anomaly_types": [
        "timing_anomaly",
        "synchronization_shift",
        "frequency_change"
      ]
    },
    "channel_4_memory_patterns": {
      "name": "Memory Patterns",
      "description": "Observe memory access and storage pattern modifications",
      "metrics": [
        "memory_usage",
        "access_patterns",
        "storage_efficiency",
        "pattern_complexity"
      ],
      "anomaly_types": [
        "pattern_change",
        "access_shift",
        "efficiency_drop"
      ]
    },
    "channel_5_instruction_sequences": {
      "name": "Instruction Sequences",
      "description": "Track instruction execution patterns and sequence modifications",
      "metrics": [
        "sequence_length",
        "complexity_score",
        "branching_factor",
        "execution_patterns"
      ],
      "anomaly_types": [
        "sequence_complexity_change",
        "branching_anomaly",
        "pattern_evolution"
      ]
    }
  },
  "communication_protocols": {
    "basic_ping": {
      "name": "Basic Ping",
      "description": "Simple ping to test basic responsiveness",
      "execution_time_ms": 1000,
      "expected_responses": ["timing_change", "pattern_shift"]
    },
    "pattern_injection": {
      "name": "Pattern Injection",
      "description": "Inject specific patterns to test entity adaptation",
      "execution_time_ms": 5000,
      "expected_responses": ["memory_pattern_change", "convergence_shift"]
    },
    "sequence_disruption": {
      "name": "Sequence Disruption",
      "description": "Disrupt instruction sequences to observe recovery",
      "execution_time_ms": 3000,
      "expected_responses": ["sequence_complexity_change", "error_pattern_shift"]
    },
    "temporal_synchronization": {
      "name": "Temporal Synchronization",
      "description": "Test synchronized timing across channels",
      "execution_time_ms": 10000,
      "expected_responses": ["timing_correlation", "cross_channel_sync"]
    },
    "memory_probe": {
      "name": "Memory Probe",
      "description": "Probe memory patterns for responsive behavior",
      "execution_time_ms": 7000,
      "expected_responses": ["memory_access_change", "storage_pattern_shift"]
    }
  },
  "statistical_analysis": {
    "correlation_window_size": 50,
    "moving_average_window": 20,
    "trend_analysis_points": 100,
    "cross_channel_analysis_interval_ms": 5000,
    "report_generation_interval_ms": 30000
  },
  "entity_response_criteria": {
    "minimum_indicators_required": 3,
    "indicators": [
      {
        "name": "pattern_change",
        "weight": 0.25,
        "threshold": true
      },
      {
        "name": "correlation_high",
        "weight": 0.20,
        "threshold": 0.8
      },
      {
        "name": "timing_correlation_high",
        "weight": 0.20,
        "threshold": 0.7
      },
      {
        "name": "deviation_significant",
        "weight": 0.20,
        "threshold": 3.0
      },
      {
        "name": "frequency_shift_notable",
        "weight": 0.15,
        "threshold": 0.5
      }
    ]
  }
}