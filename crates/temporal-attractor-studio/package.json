{
  "name": "temporal-attractor-studio",
  "version": "0.1.2",
  "description": "High-performance chaos analysis and Lyapunov exponent calculation in WebAssembly with MCP support",
  "main": "pkg-node/temporal_attractor_studio.js",
  "types": "pkg-node/temporal_attractor_studio.d.ts",
  "type": "module",
  "bin": {
    "temporal-attractor-studio": "./cli.js",
    "tas": "./cli.js",
    "tas-mcp": "./mcp-server.js"
  },
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg --features wasm --no-default-features",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node --features wasm --no-default-features",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler --features wasm --no-default-features",
    "build:all": "npm run build:node && npm run build && npm run build:bundler",
    "serve": "python3 -m http.server 8000",
    "test": "node validate-wasm.js",
    "mcp": "node mcp-server.js",
    "prepublish": "npm run build:node"
  },
  "keywords": [
    "chaos",
    "lyapunov",
    "attractor",
    "temporal",
    "dynamics",
    "wasm",
    "webassembly",
    "prediction",
    "time-series"
  ],
  "author": "rUv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/sublinear-time-solver"
  },
  "files": [
    "pkg-node/**/*",
    "pkg/**/*",
    "mcp-server.js",
    "cli.js",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}