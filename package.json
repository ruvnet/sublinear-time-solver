{
  "name": "sublinear-time-solver",
  "version": "1.8.0",
  "description": "Sparse linear solvers (Neumann, Jacobi, Gauss-Seidel, conjugate gradient), PageRank, personalized PageRank and local forward/backward push, as an MCP server, CLI and library. The dependency-free core ships separately as @ruvnet/sublinear-core.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "sublinear-time-solver": "dist/cli/index.js",
    "sublinear-solver": "dist/cli/index.js",
    "sublinear": "dist/cli/index.js",
    "strange-loops": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./tools": {
      "types": "./dist/mcp/tools/index.d.ts",
      "import": "./dist/mcp/tools/index.js"
    }
  },
  "files": [
    "dist/",
    "!dist/benchmarks/",
    "!dist/reasongraph/",
    "!dist/consciousness/genuine_consciousness_detector.*",
    "!dist/consciousness/independent_verification_system.*",
    "!dist/cli/consciousness-simple.*",
    "!dist/core/high-performance-solver.*",
    "!dist/core/memory-manager.*",
    "!dist/core/optimized-matrix.*",
    "!dist/core/optimized-solver.*",
    "!dist/core/performance-optimizer.*",
    "!dist/core/wasm-bridge.*",
    "!dist/core/wasm-integration.*",
    "!dist/core/wasm-loader.*",
    "!dist/mcp/tools/*-backup.*",
    "!dist/mcp/tools/psycho-symbolic-complete.*",
    "!dist/mcp/tools/psycho-symbolic-enhanced.*",
    "!dist/mcp/tools/psycho-symbolic-fixed.*",
    "!dist/mcp/tools/psycho-symbolic-learning.*",
    "!dist/mcp/tools/simple-wasm-solver.*",
    "!dist/mcp/tools/solver-pagerank.*",
    "!dist/mcp/tools/wasm-sublinear-solver-simple.*",
    "!dist/wasm/extractors*",
    "!dist/wasm/planner*",
    "!dist/wasm/graph_reasoner*",
    "!dist/wasm/temporal_neural_solver*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "packages/sublinear-core",
    "crates/temporal-lead-solver"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:core && npm run build:ts && npm run build:wasm",
    "build:ts": "tsc",
    "build:wasm": "node scripts/copy-wasm.js",
    "build:dev": "tsc --watch",
    "clean": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))for(const e of fs.readdirSync('dist'))if(e!=='wasm')fs.rmSync('dist/'+e,{recursive:true,force:true})\"",
    "test": "npm run build && node --test tests/regression-1.8.test.mjs tests/regression-1.8.1.test.mjs tests/mcp-sublinear-wire.test.mjs tests/consciousness/safe-path.test.mjs && npm test -w @ruvnet/sublinear-core",
    "lint": "echo 'Linting would go here'",
    "start": "npm run build && node dist/mcp/server.js",
    "serve": "npm run build && node dist/cli/index.js serve",
    "dev:serve": "tsx src/cli/index.ts serve",
    "solve": "npm run build && node dist/cli/index.js solve",
    "analyze": "npm run build && node dist/cli/index.js analyze",
    "pagerank": "npm run build && node dist/cli/index.js pagerank",
    "build:core": "npm run build -w @ruvnet/sublinear-core",
    "bench": "npm run bench -w @ruvnet/sublinear-core"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ora": "^5.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "uuid": "^11.1.1",
    "wasm-pack": "^0.15.0",
    "ws": "^8.14.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ruvnet/sublinear-core": "^1.0.0",
    "commander": "^9.4.1",
    "temporal-lead-solver": "^0.1.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "linear-algebra",
    "sparse-matrix",
    "solver",
    "sublinear",
    "pagerank",
    "personalized-pagerank",
    "forward-push",
    "backward-push",
    "random-walk",
    "neumann-series",
    "conjugate-gradient",
    "gauss-seidel",
    "diagonally-dominant",
    "graph-algorithms",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code",
    "codex",
    "cli",
    "typescript"
  ],
  "author": "rUv <github.com/ruvnet>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/sublinear-time-solver.git"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/sublinear-time-solver/issues"
  },
  "homepage": "https://github.com/ruvnet/sublinear-time-solver#readme"
}
